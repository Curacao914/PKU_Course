[Unit]
Description=定时执行课程闭环（每天 07:30 / 19:30 两次检测）
Documentation=https://course.law-tech.dev

[Timer]
# 每天两次检测：登录教学网登记新回放，再推进各阶段。
# 写笔记由成本窗口自己把关（DeepSeek 峰段 09:00—12:00 与 14:00—18:00 会顺延到窗口开启，
# 不消耗任何模型调用）；转写与下载不限时段。因此这两个时间点只是"多久看一眼教学网"，
# 07:30 在峰段之前，19:30 在谷段，两次都能把当天的作业推到该到的位置。
OnCalendar=*-*-* 07,19:30:00
# 机器停机错过的轮次在恢复后补跑一次，避免静默漏掉整天
Persistent=true
AccuracySec=1min
Unit=course-cycle.service

[Install]
WantedBy=timers.target
