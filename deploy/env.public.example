# 公开站点进程的环境文件（course-site.service 的 EnvironmentFile）。
#
# 位置：~/.course-worker/env.public（仓库之外，重新部署不会覆盖）
# 语法：systemd 的 EnvironmentFile —— **注释必须独占一行**，值不用引号，
#       也不做 shell 展开（%h 在这里无效，路径要写全）。
# 纪律：这个文件里**不该出现任何机密**。PKU 账号、百炼 Key、R2 凭据、管理令牌
#       都属于 ~/.course-worker/env（管理进程读的那个）。写完自查：
#         grep -Ei 'password|token|secret|key' ~/.course-worker/env.public   # 应当没有输出
#
# 角色（COURSE_SITE_ROLE=public）、站点目录、端口、监听地址写在单元文件里，
# 而且角色在单元里**后写**，所以这里改了也不生效——那是有意的。

# 浏览器访问 /admin 时 302 去的地址（管理台在另一个进程/域名上）
COURSE_ADMIN_ORIGIN=https://admin.law-tech.dev

# 站点目录之外的自有静态资源（Mermaid 等）。站点目录每次发布全量重写，不适合放这些。
COURSE_ASSETS_DIR=/home/ubuntu/.course-worker/assets

# ---------- 限流与请求预算（/api/search 与 /mcp 共用同一本账）----------
# 说明见 docs/12 §7.3.1；留空 = 用内置默认值（下面括号里）。

# 可信代理名单：只有直连方在这个名单里时才会读 X-Forwarded-For。
#   nginx 在本机 → 127.0.0.1,::1；**留空 = 谁都不信，只认 TCP 对端地址**
#   （那样所有读者共用一个限流桶）。不要填 0.0.0.0/0。
# 配套的 nginx 指令（默认就带，确认一下即可，见 deploy/nginx-course.conf.example）：
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# 它把真实客户端**追加**在 XFF 末尾，服务端取"最右不可信跳"，客户端伪造的前缀无效。
COURSE_TRUSTED_PROXIES=127.0.0.1,::1

# 前面还有 Cloudflare（橙云/隧道）时，直接取它设的那个单值头更准：
# CF-Connecting-IP 由 Cloudflare 写入，且只有在"直连方可信"时才会被采用。
COURSE_CLIENT_IP_HEADER=

# 每 IP 每窗口的请求数（300）
COURSE_RATE_LIMIT_MAX=
# 限流窗口毫秒数（60000）
COURSE_RATE_LIMIT_WINDOW_MS=
# 全局同时在处理的请求数（8）
COURSE_MAX_CONCURRENT=
# 单次请求墙钟预算，超了回 504 并中止检索（20000）
COURSE_REQUEST_TIMEOUT_MS=
# 查询串长度上限，超了 /api/search 回 400、MCP 回 isError（200）
COURSE_MAX_QUERY_CHARS=
