# Install as ~/.course-worker/control-env (0600). Never source OWNER env here.
COURSE_CONTROL_SIGNING_KEY=
COURSE_ACCOUNT_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COURSE_CONTROL_HOST=127.0.0.1
COURSE_CONTROL_PORT=3102
COURSE_MEMBER_ROOT=/home/ubuntu/.course-worker/accounts
COURSE_LEDGER_PATH=/home/ubuntu/.course-worker/ledger.sqlite
COURSE_MEMBER_SYNC_INTERVAL_MINUTES=60
COURSE_MEMBER_MIN_FREE_BYTES=12884901888
COURSE_MEMBER_AI_MODEL=deepseek-chat
COURSE_CHROME_PATH=
COURSE_PYTHON=/home/ubuntu/venvs/course/bin/python
# Dedicated MEMBER bucket/token. Never use OWNER R2 token. Control uses the same MEMBER bucket.
COURSE_MEMBER_R2_ENDPOINT=
COURSE_MEMBER_R2_BUCKET=
COURSE_MEMBER_R2_ACCESS_KEY_ID=
COURSE_MEMBER_R2_SECRET_ACCESS_KEY=
