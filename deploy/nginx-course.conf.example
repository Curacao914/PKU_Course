# course.law-tech.dev / admin.law-tech.dev 的反代配置
#
# 这个文件是**线上 /etc/nginx/sites-available/course 的整理版**（2026-09-28 从服务器原样抄回）。
# 装法：
#   sudo cp deploy/nginx-course.conf.example /etc/nginx/sites-available/course
#   sudo diff -u /etc/nginx/sites-available/course deploy/nginx-course.conf.example   # 先看清差异
#   sudo nginx -t && sudo systemctl reload nginx
#
# 与请求预算有关的一行（服务端按它做每 IP 限流，见 packages/notes-mcp/src/budget.mjs）：
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# 它把真实客户端**追加**到 XFF 末尾，所以服务端取"最右不可信跳"就是真客户端，
# 客户端自己伪造的前缀换不掉身份。前提是 env.public 里写 COURSE_TRUSTED_PROXIES=127.0.0.1,::1
# （nginx 就在本机）——不写的话服务端不读任何转发头，所有读者共用一个限流桶。

# ---------- 公开站点 ----------
# course.law-tech.dev —— 直连入口（不再经 Cloudflare 隧道）
#
# 为什么：这台机器在上海（国内带宽 150MB/s），而 Cloudflare 隧道最近的边缘在洛杉矶，
# 所有流量绕一圈回来被压到 100—250KB/s。直连之后网站与上传都是国内速度。
# Cloudflare 仍然负责 DNS 与证书续期的 DNS 验证；隧道保留给 cf.law-tech.dev 作兜底。
server {
    listen 80;
    listen [::]:80;
    server_name course.law-tech.dev;

    # 证书续期用 HTTP-01 备选入口（主用 DNS-01，这个只是保险）
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    # http2 由 listen 参数开启（nginx 1.24）
    server_name course.law-tech.dev;

    ssl_certificate     /etc/letsencrypt/live/course.law-tech.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/course.law-tech.dev/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 课件动辄几十兆，默认 1M 会被挡回来
    client_max_body_size 256m;
    client_body_timeout 300s;
    # 管理台里的「跑一轮」可能跑十几分钟，别让代理先超时
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;
    proxy_request_buffering off;

    access_log /var/log/nginx/course.access.log;
    error_log  /var/log/nginx/course.error.log;

    # Vercel 上的 law-tech.dev 通过这一条访问多用户控制面。
    # 浏览器本身拿不到 COURSE_CONTROL_SIGNING_KEY；请求必须由 law-tech 服务端转发。
    location ^~ /_control/ {
        proxy_pass http://127.0.0.1:3102/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        client_max_body_size 1m;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------- 管理台 ----------
# admin.law-tech.dev —— 管理台专用入口，转到**另一个进程**（3101）。
# 公开进程（3100）上根本没有 /admin 与 /api/admin 这些路由，也不加载任何机密。
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.law-tech.dev;

    ssl_certificate     /etc/letsencrypt/live/course.law-tech.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/course.law-tech.dev/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 256m;
    client_body_timeout 300s;
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;
    proxy_request_buffering off;

    access_log /var/log/nginx/course-admin.access.log;
    error_log  /var/log/nginx/course-admin.error.log;

    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name admin.law-tech.dev;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
