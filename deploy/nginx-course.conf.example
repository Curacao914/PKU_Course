# course.law-tech.dev / admin.law-tech.dev 的反代配置
#
# 这个文件是**线上 /etc/nginx/sites-available/course 的整理版**（2026-09-28 从服务器原样抄回）。
# 装法：
#   sudo cp deploy/nginx-course.conf.example /etc/nginx/sites-available/course
#   sudo diff -u /etc/nginx/sites-available/course deploy/nginx-course.conf.example   # 先看清差异
#   sudo nginx -t && sudo systemctl reload nginx
#
# 与请求预算有关的一行（服务端按它做每 IP 限流，见 packages/notes-mcp/src/budget.mjs）：
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# 它把真实客户端**追加**到 XFF 末尾，所以服务端取"最右不可信跳"就是真客户端，
# 客户端自己伪造的前缀换不掉身份。前提是 env.public 里写 COURSE_TRUSTED_PROXIES=127.0.0.1,::1
# （nginx 就在本机）——不写的话服务端不读任何转发头，所有读者共用一个限流桶。

limit_req_zone $binary_remote_addr zone=course_control:10m rate=10r/s;

# ---------- 公开站点 ----------
# course.law-tech.dev —— 课程唯一用户入口。
# Cloudflare Tunnel 把该域名送到本机 nginx；公开笔记与管理台在同一域名分流：
#   /、阅读页等       → 3100 public
#   /admin、/api/admin → 3101 admin
#   /_control          → 3102 control
server {
    listen 80;
    listen [::]:80;
    server_name course.law-tech.dev;

    # 证书续期用 HTTP-01 备选入口（主用 DNS-01，这个只是保险）
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    # http2 由 listen 参数开启（nginx 1.24）
    server_name course.law-tech.dev;

    ssl_certificate     /etc/letsencrypt/live/course.law-tech.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/course.law-tech.dev/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # 课件动辄几十兆，默认 1M 会被挡回来
    client_max_body_size 256m;
    client_body_timeout 300s;
    # 管理台里的「跑一轮」可能跑十几分钟，别让代理先超时
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;
    proxy_request_buffering off;

    access_log /var/log/nginx/course.access.log;
    error_log  /var/log/nginx/course.error.log;

    # course.law-tech.dev/ 是课程工具的唯一入口：先由管理进程做 law-tech SSO。
    location = / {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SSO 短票据回调只交给管理进程；成功后会写 HttpOnly course session cookie。
    location ^~ /_auth/ {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }

    # 完整课程管理台统一挂在 course.law-tech.dev/admin。
    # 长动作已经改为立即返回 jobId + 轮询，因此可安全经 Cloudflare Tunnel。
    location = /admin {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location ^~ /admin/ {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location ^~ /api/admin/ {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_request_buffering off;
        client_max_body_size 256m;
        add_header Cache-Control "no-store" always;
    }

    # Vercel 上的 law-tech.dev 通过这一条访问多用户控制面。
    # 浏览器本身拿不到 COURSE_CONTROL_SIGNING_KEY；请求必须由 law-tech 服务端转发。
    location ^~ /_control/ {
        limit_req zone=course_control burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3102/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        client_max_body_size 1m;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------- 旧管理台域名兼容 ----------
# admin.law-tech.dev 不再作为正式入口；旧链接只跳回 course.law-tech.dev/。
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.law-tech.dev;

    ssl_certificate     /etc/letsencrypt/live/course.law-tech.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/course.law-tech.dev/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 302 https://course.law-tech.dev/;
}

server {
    listen 80;
    listen [::]:80;
    server_name admin.law-tech.dev;
    return 302 https://course.law-tech.dev/;
}
