# course.law-tech.dev worker 配置模板
#
# 部署位置：服务器 ~/.course-worker/env（0600，仓库之外，重新部署不会覆盖）
# 加载顺序：已存在的环境变量 > 本文件 > 内置默认值
# 校验方式：course doctor 会报告每个键是 set 还是 missing，且从不回显取值。

# ---------- 北大教学网 ----------
PKU_USERNAME=
PKU_PASSWORD=
COURSE_START_URL=https://course.pku.edu.cn/

# Chrome 可执行文件。服务器上用 Playwright 自带的 Chromium：
#   ls -d ~/.cache/ms-playwright/chromium-*/chrome-linux/chrome
COURSE_CHROME_PATH=
# 无头模式：1 为无头（服务器必须）。本地调试想看浏览器页面时设为 0。
COURSE_HEADLESS=1

# 下载调优（默认值即下面这些，通常不用改）
COURSE_DOWNLOAD_CONCURRENCY=4
COURSE_FETCH_ATTEMPTS=4
COURSE_SEGMENT_TIMEOUT_MS=90000
COURSE_DOWNLOAD_PROGRESS_EVERY=5

# ---------- 转录（阿里云百炼 Paraformer-v2）----------
DASHSCOPE_API_KEY=
COURSE_ASR_CHUNK_MINUTES=45
# 是否允许付费转录。首次跑通建议先设 0，确认链路后再放开。
COURSE_ASR_ALLOW_PAID=0
COURSE_ASR_MAX_TASK_COST_CNY=2
COURSE_ASR_DAILY_MAX_COST_CNY=5
COURSE_ASR_PRICE_PER_HOUR_CNY=0.288
# 免费额度（秒）。留空表示不使用免费额度记账。
COURSE_ASR_FREE_SECONDS_BUDGET=
COURSE_ASR_MAX_TASK_SECONDS=
COURSE_ASR_DAILY_MAX_SECONDS=
COURSE_ASR_BUDGET_TIME_ZONE=Asia/Shanghai

# ---------- 临时对象存储（Cloudflare R2）----------
# Paraformer 需要能公网读取的音频地址，因此每个分片会临时上传 R2，
# 任务结束后立即删除。整段视频不会上传。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=

# ---------- 备份的异地副本 ----------
# 同一块盘上的备份挡不住盘坏、误删、机器被回收，所以 course backup 支持把快照
# 再送一份到这台机器之外。值是**一条命令模板**，{} 会被替换成快照文件路径；
# 命令失败会让 backup 退出码非 0（交给 systemd/cron 报警），不会悄悄吞掉。
# 仓库自带 tools/r2-put.py：复用 ASR 那套 R2 凭据与 boto3，上传后立刻 HEAD 校验。
# 值里有空格，必须加引号——env 文件是被 shell source 的。
COURSE_BACKUP_OFFSITE="/home/ubuntu/venvs/course/bin/python /home/ubuntu/course-runtime/tools/r2-put.py {} course-backups/"

# ---------- 运行时 ----------
COURSE_WORKER_SCRATCH_DIR=/home/ubuntu/.course-worker
# 必须是装了 boto3 的解释器。服务器上就是仓库内的 venv，不要用系统 python3。
# 虚拟环境放在 release 之外（~/venvs/course），每个 release 里只是一个符号链接：
# 放在 release 里的话，发布一次就会被"留在旧目录"，新版本立刻报 python missing。
COURSE_PYTHON=/home/ubuntu/venvs/course/bin/python
COURSE_FFMPEG=ffmpeg
COURSE_FFPROBE=ffprobe
# 换一个配置文件位置（默认即 ~/.course-worker/env）
COURSE_ENV_FILE=
